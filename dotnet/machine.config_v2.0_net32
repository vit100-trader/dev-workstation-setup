  <dealertrack_commonsettings>
    <setting environment="dev">
      <common>
        <OracleProvider>ADO</OracleProvider>
        <dbconnectionstring>User ID=dtcn;password=dtcn;DATA SOURCE=DTCAN</dbconnectionstring>
        <usererrormsg>Technical difficulties (Test) - Please call the help desk at 1-866-360-3863.</usererrormsg>
        <isdebug>yes</isdebug>
        <websitename>http://dtcweb1d.canada.dt.inc</websitename>
        <schemalocation>http://dtcweb1d.canada.dt.inc</schemalocation>
        <xdrdir>/schemas/</xdrdir>
        <jf_virtualdirectory>collection</jf_virtualdirectory>
        <jf_collectiondirectory>D:\jetform\central\server\data\</jf_collectiondirectory>
        <dtctimezone>EST</dtctimezone>
        <wheretolog>queue</wheretolog>
        <!-- queue or textfile -->
        <logqueuename>DIRECT=TCP:192.168.60.5\Private$\DealerTrackLogs</logqueuename>
        <logmessagetype>recoverablemessage</logmessagetype>
        <!--expressmessage or recoverablemessage -->
        <logtextfoldername>D:\website\Adminlogs\</logtextfoldername>
        <credit_bureau_active>yes</credit_bureau_active>
        <requeueretry>2500</requeueretry>
        <appv2_active>yes</appv2_active>
        <gmac_active>no</gmac_active>
        <gettickcount_active>yes</gettickcount_active>
        <econtract_active>yes</econtract_active>
        <billing_active>yes</billing_active>
        <sendsilanisqname>DIRECT=OS:NDTDB1T\silpadorder</sendsilanisqname>
        <logviewmax>500</logviewmax>
        <logdownloadmax>10000</logdownloadmax>
        <faxq>direct=os:192.168.60.5\appsubifax</faxq>
        <padcosts>new</padcosts>
        <padvendorname>S</padvendorname>
        <sendinterlinkqname>DIRECT=TCP:192.168.60.5\interlinkpadorder</sendinterlinkqname>
        <Bank1ChaseMergeActive>yes</Bank1ChaseMergeActive>
        <sendtocwebqname>direct = OS:dtlender2q\Private$\cwdlrprofile</sendtocwebqname>
        <countryhawk_exclude_ips>10,172.16,172.17,172.18,172.19,172.20,172.21,172.22,172.23,172.24,172.25,172.26,172.27,172.28,172.29,172.30,172.31,192.168</countryhawk_exclude_ips>
        <ts_display_active>Y</ts_display_active>
        <userstateconnectionstring>User ID=dtcn;password=dtcn;DATA SOURCE=DTCAN</userstateconnectionstring>
        <compliance_active>Y</compliance_active>
        <bpo_dbconnstring>User ID=xtra;password=NY5tore5afe;DATA SOURCE=BPO</bpo_dbconnstring>
